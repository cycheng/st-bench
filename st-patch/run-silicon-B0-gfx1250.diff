diff --git a/projects/hipblaslt/clients/CMakeLists.txt b/projects/hipblaslt/clients/CMakeLists.txt
index a47a1600c76..5e4aa25f746 100755
--- a/projects/hipblaslt/clients/CMakeLists.txt
+++ b/projects/hipblaslt/clients/CMakeLists.txt
@@ -127,7 +127,23 @@ if(HIPBLASLT_ENABLE_YAML)
     target_include_directories(hipblaslt-sequence PRIVATE ${LLVM_INCLUDE_DIRS})
 endif()
 if(BUILD_TESTING OR HIPBLASLT_BUILD_TESTING)
+
     find_package(GTest CONFIG REQUIRED)
+
+    get_target_property(_gtest_location GTest::gtest IMPORTED_LOCATION_NOCONFIG)
+    message(STATUS "GTest::gtest IMPORTED_LOCATION_NOCONFIG=${_gtest_location}")
+
+    if(NOT _gtest_location OR _gtest_location MATCHES "NOTFOUND")
+        find_library(_gtest_location NAMES gtest REQUIRED)
+        message(STATUS "Fallback libgtest=${_gtest_location}")
+    endif()
+
+    set_target_properties(GTest::gtest PROPERTIES
+        IMPORTED_LOCATION "${_gtest_location}"
+        IMPORTED_LOCATION_RELEASE "${_gtest_location}"
+        IMPORTED_LINK_INTERFACE_LANGUAGES "CXX"
+        IMPORTED_LINK_INTERFACE_LANGUAGES_RELEASE "CXX"
+    )
     add_executable(hipblaslt-test)
     if(amd_smi_FOUND)
         target_link_libraries(hipblaslt-test PRIVATE amd_smi)
